# Supabase 项目配置 - 在 https://supabase.com 创建项目后获取
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 高德地图 Key — 在 https://lbs.amap.com 申请
# 控制台 → 应用管理 → 创建新应用 → 添加 Key（选 Web端 JS API）
NEXT_PUBLIC_AMAP_KEY=your-amap-key-here
NEXT_PUBLIC_AMAP_SECURITY_CODE=your-amap-security-code-here
